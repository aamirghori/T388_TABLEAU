      <aliases enabled='yes' />
      <column caption='REVIEW PERFORMANCE SCORE' datatype='integer' name='[Calculation_0212540792360960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]*[Review Scores Rating]' />
      </column>
      <column caption='PRICE CATEGORY' datatype='string' name='[Calculation_0212540794245121]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;300 THEN &quot;luxury&quot; ELSEIF [Price]&gt;150 THEN &quot;STANDARD&quot; ELSE &quot;BUDGET&quot; END' />
      </column>
      <column caption='COUNT OF HOTELS ' datatype='integer' name='[Calculation_0212540797063170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Name])' />
      </column>
      <column caption='HOST STATUS' datatype='string' name='[Calculation_0212540801249283]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since]&lt; TODAY() THEN &quot;active host&quot; ELSE &quot;NEW HOST&quot; END' />
      </column>
      <column caption='REVIEW CATEGORY' datatype='string' name='[Calculation_0212540801953796]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews]&gt;=100 THEN &quot;HIGHLY REVIEWED&quot;&#13;&#10;ELSE &quot;LESS REVIEWED&quot; END' />
      </column>
      <column caption='PRICE FILTER CATEGORY ' datatype='string' name='[Calculation_0212540803850246]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; [Parameters].[Parameter 0212540802654213]THEN &quot;ABOVE Limit&quot; ELSE &quot;Below Limit&quot; END' />
      </column>
      <column caption='HOST SINCE NEW' datatype='date' name='[Calculation_0212540811804682]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since],DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='REVIEW SCORE RATING(BIN)' datatype='integer' name='[Calculation_0212540812812299]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Review Scores Rating (bin)],0)' />
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
